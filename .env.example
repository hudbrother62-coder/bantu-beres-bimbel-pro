# Neon pooled connection string. Never expose to the browser.
DATABASE_URL=
# Direct Neon connection for migrations (fallback: DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Exact deployed URL, without a trailing slash.
APP_URL=http://localhost:3000

# Lupa password via email OTP (required for production recovery).
# Configure a verified sending domain in Resend; do not put real keys in Git.
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Smart OTP Queue: 32-byte random secret in hex, and cron bearer token
OTP_QUEUE_ENCRYPTION_KEY=
CRON_SECRET=
OTP_QUEUE_HOURLY_LIMIT=20
